# Copy to .env (repo root) and fill in. Never commit .env.

# AI (Anthropic Claude, vision). Required for live grading.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high (Sonnet 5.5 default is high; medium keeps grading fast)
ANTHROPIC_EFFORT=medium

# Database + private image bucket (Supabase). Leave empty to run on the in-memory test store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=submissions

# Web app -> API
VITE_API_URL=http://localhost:8000

# Privacy: delete the photo from storage after the teacher approves (scores, feedback and review record are kept).
DELETE_IMAGES_ON_APPROVE=false

# Demo safety net: return cached AI results (samples/cache, keyed by image SHA-256) when available.
DEMO_MODE=false

# API settings
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IMAGE_SIGNING_SECRET=change-me
APP_TIMEZONE=Asia/Manila
DEMO_TEACHER_EMAIL=reyes@school.edu.ph
DEMO_TEACHER_PASSWORD=tsekmate
