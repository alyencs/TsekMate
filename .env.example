# Copy to .env (repo root) and fill in. Never commit .env.

# AI (Google Gemini, vision). Required for live grading. Server side only: never prefix with VITE_.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: cap Gemini 2.5 "thinking" tokens (0 = off on Flash; empty = model default)
GEMINI_THINKING_BUDGET=
# Retries on 429/5xx, including the first attempt
GEMINI_RETRY_ATTEMPTS=3
# Papers graded in parallel. Keep low on the free tier (requests per minute are limited).
GRADING_WORKERS=2

# Database + private image bucket (Supabase). Leave empty to run on the in-memory test store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=submissions

# Web app -> API
VITE_API_URL=http://localhost:8000

# Privacy: delete the photo from storage after the teacher approves (scores, feedback and review record are kept).
DELETE_IMAGES_ON_APPROVE=false

# Demo safety net: return cached AI results (samples/cache, keyed by image SHA-256) when available.
DEMO_MODE=false

# API settings
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IMAGE_SIGNING_SECRET=change-me
APP_TIMEZONE=Asia/Manila
DEMO_TEACHER_EMAIL=reyes@school.edu.ph
DEMO_TEACHER_PASSWORD=tsekmate
