# Copy to .env (repo root) and fill in. Never commit .env.

# AI (Anthropic Claude, vision). Required for live grading. Server side only: never prefix with VITE_.
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Papers graded in parallel (keeps request bursts under API rate limits).
GRADING_WORKERS=2
# Saver grading (Settings -> Grading speed): how often to check for batch results, in seconds.
BATCH_POLL_SECONDS=30

# Database + private image bucket (Supabase). Leave empty to run on the in-memory test store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=submissions

# Web app -> API
VITE_API_URL=http://localhost:8000

# Privacy: starting value of the Settings toggle "Delete the photo after approval" (scores, feedback, review record are kept).
DELETE_IMAGES_ON_APPROVE=false

# Demo safety net: return cached AI results (samples/cache, keyed by image SHA-256) when available.
DEMO_MODE=false

# API settings
# development (default): empty secrets are replaced by random ones for each run, and the demo password "tsekmate" works.
# production: the API refuses to start unless AUTH_SECRET and IMAGE_SIGNING_SECRET are set (32+ characters, different)
# and DEMO_TEACHER_PASSWORD is a real password (10+ characters). The Dockerfile sets APP_ENV=production.
APP_ENV=development
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
IMAGE_SIGNING_SECRET=
SESSION_HOURS=12
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional pattern for preview deployments, e.g. ^https://tsekmate(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=
APP_TIMEZONE=Asia/Manila
# The single teacher account. Leave the password empty in development to use the local demo password.
DEMO_TEACHER_EMAIL=areyes@university.edu.ph
DEMO_TEACHER_PASSWORD=
# A paper left in "grading" this long by a run that no longer exists is released for Grade again.
GRADING_STALE_MINUTES=30
